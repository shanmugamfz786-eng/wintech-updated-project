# ==============================================================================
# WINTECH DIGITAL PARTNER - BACKEND CONFIGURATION (.env)
# ==============================================================================

PORT=5000

# ------------------------------------------------------------------------------
# 1. TiDB Cloud Production Database (Serverless / Dedicated MySQL-compatible)
# ------------------------------------------------------------------------------
# Obtain your cluster endpoint, username, and password from https://tidbcloud.com/
# When left empty, the server operates in zero-config offline mode with an in-memory store.
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=wintech_db
TIDB_ENABLE_SSL=true

# ------------------------------------------------------------------------------
# 2. Admin Email Notifications (Optional - Safely disabled if credentials not set)
# ------------------------------------------------------------------------------
# To receive an email each time a customer submits a contact enquiry:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_business_email@gmail.com
# SMTP_PASS=your_app_specific_password
# NOTIFICATION_RECIPIENT=info@wintechdigitalpartner.com

# ------------------------------------------------------------------------------
# 3. Security & Admin Authorization (Required before production deployment)
# ------------------------------------------------------------------------------
# Secret key required to access GET /api/enquiries (via header 'x-admin-key')
# ADMIN_SECRET_KEY=generate_a_secure_random_hex_key_here


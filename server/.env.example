# ==============================================================================
# WINTECH DIGITAL PARTNER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Vercel, add these under: Project Settings -> Environment Variables

NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 1. Database (TiDB Serverless / MySQL Cloud)
# ------------------------------------------------------------------------------
# NOTE: Vercel serverless has an ephemeral filesystem. TiDB Cloud is REQUIRED
# for permanent persistence on Vercel so enquiries are never lost on redeploy.
# Obtain free serverless cluster credentials from: https://tidbcloud.com/
TIDB_HOST=your-tidb-cluster-host.clusters.tidb-cloud.com
TIDB_PORT=4000
TIDB_USER=your-tidb-username.root
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=wintech_db
TIDB_ENABLE_SSL=true

# ------------------------------------------------------------------------------
# 2. Email Notifications (Optional - Gmail SMTP or any standard SMTP)
# ------------------------------------------------------------------------------
# If left unset, email notifications are safely disabled without breaking submissions.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-actual-email@gmail.com
SMTP_PASS=your-16-character-app-password
NOTIFICATION_RECIPIENT=your-notification-inbox@gmail.com

# ------------------------------------------------------------------------------
# 3. Admin Authentication & Security (REQUIRED for Production)
# ------------------------------------------------------------------------------
# Used to authenticate at https://your-domain.vercel.app/#admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-production-password-here
ADMIN_SECRET_KEY=generate-a-random-32char-secret-key-for-session-tokens
